generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Paciente {
  idPaciente       Int      @id @default(autoincrement())
  nome             String   @db.VarChar(100)
  cpf              String   @db.VarChar(15)
  dataNascimento   DateTime @db.Date
  telefone         String   @db.VarChar(15)
  email            String   @unique @db.VarChar(100)
  endereco         String   @db.VarChar(100)
  nSus             String   @db.VarChar(45)
  senhaAcesso      String   @db.VarChar(255)

  filaEsperaId     Int?
  filaEspera       FilaEspera? @relation(fields: [filaEsperaId], references: [idFilaEspera])

  agendamentos     Agendamento[]
  senhas           Senha[]
  prontuarios      Prontuario[]
}

model Agendamento {
  idAgendamento    Int      @id @default(autoincrement())
  dataSolicitacao  DateTime @db.Date
  dataHora         DateTime
  tipo             String   @db.VarChar(100)
  status           String   @db.VarChar(50)

  agendaId         Int
  agenda           Agenda   @relation(fields: [agendaId], references: [idAgenda])

  pacienteId       Int
  paciente         Paciente @relation(fields: [pacienteId], references: [idPaciente])
}

model Agenda {
  idAgenda         Int      @id @default(autoincrement())
  data             DateTime @db.Date
  horario          String   @db.VarChar(45)
  vagasDisponiveis Int

  agendamentos     Agendamento[]
  profissionais    ProfissionalSus[]
}

model ProfissionalSus {
  idProfissionalSus    Int    @id @default(autoincrement())
  nome                 String @db.VarChar(100)
  cpf                  String @db.VarChar(15)
  registroProfissional String @db.VarChar(45)
  cargo                String @db.VarChar(45)
  especialidade        String @db.VarChar(100)
  email                String @unique @db.VarChar(100)
  senhaAcesso          String @db.VarChar(255)

  agendaId             Int
  agenda               Agenda @relation(fields: [agendaId], references: [idAgenda])
}

model Senha {
  idSenha          Int      @id @default(autoincrement())
  posicao          Int
  status           String   @db.VarChar(100)

  pacienteId       Int
  paciente         Paciente @relation(fields: [pacienteId], references: [idPaciente])

  atendimentoId    Int?
  atendimento      Atendimento? @relation(fields: [atendimentoId], references: [idAtendimento])

  filaEsperaId     Int
  filaEspera       FilaEspera @relation(fields: [filaEsperaId], references: [idFilaEspera])
}

model FilaEspera {
  idFilaEspera        Int      @id @default(autoincrement())
  tipoAtendimento     String   @db.VarChar(45)
  data                DateTime @db.Date

  pacientes           Paciente[]
  senhas              Senha[]
  unidadesAtendimento UnidadeAtendimento[]
}

model UnidadeAtendimento {
  idUnidadeAtendimento Int    @id @default(autoincrement())
  nome                 String @db.VarChar(100)
  tipo                 String @db.VarChar(45)
  endereco             String @db.VarChar(100)
  telefone             String @db.VarChar(45)

  filaEsperaId         Int
  filaEspera           FilaEspera @relation(fields: [filaEsperaId], references: [idFilaEspera])
}

model Prontuario {
  idProntuario      Int      @id @default(autoincrement())
  dataCriacao       DateTime @db.Date
  observacoesGerais String   @db.VarChar(255)

  pacienteId        Int
  paciente          Paciente @relation(fields: [pacienteId], references: [idPaciente])

  atendimentos      Atendimento[]
}

model Atendimento {
  idAtendimento     Int      @id @default(autoincrement())
  dataHora          DateTime
  diagnostico       String   @db.VarChar(45)
  prescricao        String   @db.VarChar(100)
  observacoes       String   @db.VarChar(100)

  prontuarioId      Int
  prontuario        Prontuario @relation(fields: [prontuarioId], references: [idProntuario])

  notificacaoId     Int?
  notificacao       Notificacao? @relation(fields: [notificacaoId], references: [idNotificacao])

  senhas            Senha[]
}

model Administrador {
  idAdministrador Int    @id @default(autoincrement())
  nome            String @db.VarChar(100)
  cargo           String @db.VarChar(45)
  email           String @unique @db.VarChar(100)
  senhaAcesso     String @db.VarChar(255)
}

model Notificacao {
  idNotificacao   Int      @id @default(autoincrement())
  mensagem        String   @db.VarChar(100)
  dataEnvio       DateTime @db.Date
  statusLeitura   String   @db.VarChar(45)

  atendimentos    Atendimento[]
}
