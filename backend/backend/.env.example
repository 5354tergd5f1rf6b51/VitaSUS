# Copie para .env e ajuste. O arquivo .env não deve ser versionado.
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/vitasus"
# Segredo usado para assinar as sessões (JWT). Use um valor longo e aleatório.
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"
# Horas de diferença entre UTC e o horário local (Brasília = 3).
TZ_OFFSET_HORAS=3
PORT=3000
